# ============================================
# 🎯 DISPLAY KONFIGURATION (IP-basiert)
# ============================================
# Definiere deine Displays mit IP-Adresse, Namen und Qualität
# Nutze diese Format:
#   DISPLAY_<ID>_IP=<IP-ADRESSE>
#   DISPLAY_<ID>_NAME=<ANZEIGENAME>
#   DISPLAY_<ID>_QUALITY=<high|medium|low|auto>
#
# BEISPIELE:
#   DISPLAY_1_IP=192.168.1.10
#   DISPLAY_1_NAME=Wohnzimmer
#   DISPLAY_1_QUALITY=high
#   DISPLAY_2_IP=192.168.1.20
#   DISPLAY_2_NAME=Küche
#   DISPLAY_2_QUALITY=auto

DISPLAY_1_IP=192.168.1.10
DISPLAY_1_NAME=Wohnzimmer
DISPLAY_1_QUALITY=auto

DISPLAY_2_IP=192.168.1.20
DISPLAY_2_NAME=Küche
DISPLAY_2_QUALITY=auto

# DISPLAY_3_IP=192.168.1.30
# DISPLAY_3_NAME=Schlafzimmer
# DISPLAY_3_QUALITY=low

# ============================================
# 🎵 SPOTIFY INTEGRATION
# ============================================
SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here
SPOTIFY_REFRESH_TOKEN=your_refresh_token_here

# ============================================
# 📍 LOKATIONS-STANDARD
# ============================================
# Diese Werte werden als Default für neue Displays genutzt
# HUB_LAT=53.5653
# HUB_LON=11.3653
# HUB_CITY=Pampow
